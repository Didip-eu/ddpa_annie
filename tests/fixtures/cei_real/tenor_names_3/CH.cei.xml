                    </cei:chDesc>
                    <cei:tenor>
                        <cei:pTenor>Ego <cei:persName key="FontenayPersons:324645" id="d1e155081" reg="Étienne II, évêque d'Autun (1171-1189)">Stephanus, Dei gratia
                                    <cei:placeName key="stutzmann_himanis#319548" id="d1e155083" reg="Autun (Saône-et-Loire, Autun)">Eduensis</cei:placeName>
                                episcopus</cei:persName>, notum fieri volo presentibus et futuris
                            quod <cei:persName key="FontenayPersons:d1e24066" id="d1e155087">Osmundus</cei:persName> et <cei:persName key="FontenayPersons:d1e24072" id="d1e155090">Odo frater ejus de
                                    <cei:placeName key="stutzmann_himanis#324475" id="d1e155092" reg="Marmagne (Côte-d'Or, Montbard)">Marmania</cei:placeName>
                            </cei:persName> dederunt in elemosinam perpetuam ecclesie <cei:orgName key="stutzmann_himanis#282689" id="d1e155095" reg="abbaye Notre-Dame de Fontenay (1119 -)">Fonteneti</cei:orgName>
                            laudantibus sororibus suis <cei:persName key="FontenayPersons:d1e24078" id="d1e155098">Adelina</cei:persName> et <cei:persName key="FontenayPersons:d1e24084" id="d1e155102">Petronilla</cei:persName>
                            <cei:num value="99999999">xx</cei:num>
                            <cei:hi rend="superscript">ti </cei:hi>solidos quos annuatim dabant eis
                            monachi <cei:orgName key="stutzmann_himanis#282689" id="d1e155109" reg="abbaye Notre-Dame de Fontenay (1119 -)">Fonteneti</cei:orgName>
                            in martio pro omnibus querelis quas tam pater eorum quam ipsi habuerant
                            adversus eamdem domum <cei:orgName key="stutzmann_himanis#282689" id="d1e155112" reg="abbaye Notre-Dame de Fontenay (1119 -)">Fonteneti</cei:orgName>. Calumpniati enim fuerant eis decimas in
                            terris quas excolebant in territorio <cei:placeName key="stutzmann_himanis#324450" id="d1e155115" reg="Fain-lès-Montbard (Côte-d'Or, Montbard)">Fanii</cei:placeName>,
                            partem etiam orti subtus abbatiam et pratum sub chimino <cei:placeName key="stutzmann_himanis#324450" id="d1e155118" reg="Fain-lès-Montbard (Côte-d'Or, Montbard)">Fanii</cei:placeName>
                            ubi miles jacet, et<cei:hi rend="background(yellow)">
                                leschariam</cei:hi> desuper <cei:placeName key="stutzmann_himanis#324450" id="d1e155125" reg="Fain-lès-Montbard (Côte-d'Or, Montbard)">Fanium</cei:placeName>, et terram supra eamdem lescheriam ubi salices
                            edificate erant, et omnes vineas quas monachi tenebant in territorio
                                <cei:placeName key="stutzmann_himanis#324450" id="d1e155128" reg="Fain-lès-Montbard (Côte-d'Or, Montbard)">Fanii</cei:placeName>,
                            vineam scilicet <cei:persName key="FontenayPersons:d1e24091" id="d1e155131">Rainaldi <cei:addName>Esbrasati</cei:addName>
                            </cei:persName>, vineam <cei:persName key="FontenayPersons:d1e24097" id="d1e155136">Odonis <cei:addName>
                                    <cei:foreign lang="">Brandun</cei:foreign>
                                </cei:addName>
                            </cei:persName>, vineam <cei:persName key="FontenayPersons:d1e24103" id="d1e155142">Varnerii <cei:addName>
                                    <cei:foreign lang="">Viticot</cei:foreign>
                                </cei:addName>
                            </cei:persName> et terram quam habebat ad censum pro duobus nummis in
                            costa <cei:placeName key="stutzmann_himanis#324489" id="d1e155149" reg="Morville (Côte-d'Or, Montbard)">Morville</cei:placeName>.
                            Quicquid in his omnibus juris habebant <cei:persName key="FontenayPersons:d1e24109" id="d1e155152">Osmundus</cei:persName> et <cei:persName key="FontenayPersons:d1e24115" id="d1e155155">Odo</cei:persName>
                            ecclesie <cei:orgName key="stutzmann_himanis#282689" id="d1e155158" reg="abbaye Notre-Dame de Fontenay (1119 -)">Fonteneti</cei:orgName>
                            concesserunt ad censum <cei:num value="99999999">xx</cei:num>
                            <cei:hi rend="superscript">ti</cei:hi> solidorum quos postea predicte
                            ecclesie sicut prediximus in elemosinam dederunt et mansum in quo
                            grangia eorum erat quod tenuerunt <cei:persName key="FontenayPersons:d1e24121" id="d1e155167">Andreas</cei:persName>
                            et <cei:persName key="FontenayPersons:d1e24128" id="d1e155170">Felix</cei:persName> et quicquid habebant a rivo de <cei:placeName key="stutzmann_himanis#325253" id="d1e155173" reg="Correson">
                                <cei:foreign lang="">Curtresum</cei:foreign>
                            </cei:placeName>
                            <cei:hi rend="italic"> </cei:hi>usque ad finagium <cei:placeName key="stutzmann_himanis#324475" id="d1e155179" reg="Marmagne (Côte-d'Or, Montbard)">Marmanie</cei:placeName> a
                            chimino sursum et quicquid habebant in <cei:placeName key="stutzmann_himanis#325295" id="d1e155182" reg="Grenchessania">Grenchessania</cei:placeName> in bosco et in plano. Hoc totum
                            factum est laudantibus sororibus eorum et sciendum quod pro hac
                            elemosina habuerunt de beneficio ecclesie <cei:num value="99999999">xxx</cei:num>
                            <cei:hi rend="superscript">ta</cei:hi> libras. Unde testes sunt monachi
                                <cei:orgName key="stutzmann_himanis#282689" id="d1e155191" reg="abbaye Notre-Dame de Fontenay (1119 -)">Fonteneti</cei:orgName>
                            <cei:persName key="FontenayPersons:d1e24134" id="d1e155193">Willermus de
                                    <cei:placeName key="stutzmann_himanis#324331" id="d1e155195" reg="Nesle-et-Massoult (Côte-d'Or, Montbard)">
                                    <cei:foreign lang="">Naille</cei:foreign>
                                </cei:placeName>
                            </cei:persName>, <cei:persName key="FontenayPersons:d1e24140" id="d1e155199">Willermus de <cei:placeName key="stutzmann_himanis#325251" id="d1e155201" reg="Corabœuf (Côte-d'Or, Arnay-le-Duc)">Curte
                                    Rabodi</cei:placeName>
                            </cei:persName> et <cei:persName key="FontenayPersons:d1e24146" id="d1e155204">Hugo frater ejus</cei:persName>, <cei:persName key="FontenayPersons:324623" id="d1e155207" reg="Eudes, archiprêtre de Touillon (1173-1200)">Odo archipresbiter
                                    <cei:placeName key="stutzmann_himanis#324370" id="d1e155209" reg="Touillon (Côte-d'Or, Montbard)">Tullionis</cei:placeName>
                            </cei:persName>, <cei:persName key="FontenayPersons:d1e24152" id="d1e155213">Umbertus capellanus de <cei:placeName key="stutzmann_himanis#324350" id="d1e155215" reg="Ravières (Yonne, Tonnerrois)">Raveriis</cei:placeName>
                            </cei:persName>, <cei:persName key="FontenayPersons:d1e24158" id="d1e155218">Stephanus <cei:addName>Villanus</cei:addName>
                            </cei:persName> et <cei:persName key="FontenayPersons:d1e24165" id="d1e155223">Petrus <cei:addName>
                                    <cei:foreign lang="">Allerez</cei:foreign>
                                </cei:addName>
                            </cei:persName>. Hec omnia se fecisse, dedisse et laudasse coram me
                            recognoverunt duo supradicti fratres <cei:persName key="FontenayPersons:d1e24171" id="d1e155229">Osmundus</cei:persName> et <cei:persName key="FontenayPersons:d1e24177" id="d1e155232">Odo</cei:persName> et
                            ut sigillo nostro confirmarem postulaverunt. Proinde ut ista in posterum
                            stabili firmitate conserventur cartam presentem sigilli nostri munimine
                            confirmamus et omnes qui de hiis ecclesiam <cei:orgName key="stutzmann_himanis#282689" id="d1e155235" reg="abbaye Notre-Dame de Fontenay (1119 -)">Fonteneti</cei:orgName>
                            in aliquo vexare aut dampnum aliquid ausi fuerint inferre donec
                            resipiscant anathemate dampnamus, amen. Actum anno incarnationis domini
                            nostri Ihesu Christi millesimo centesimo <cei:hi rend="smallcaps">lxx°
                                vii°</cei:hi>.</cei:pTenor>
                    </cei:tenor>
                </cei:body>
