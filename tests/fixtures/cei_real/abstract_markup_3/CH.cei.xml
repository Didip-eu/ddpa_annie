                        <cei:idno id="1339-07-99_Paris_1">1339-07-99_Paris_1</cei:idno>
                        <cei:chDesc>                            
                            <cei:abstract>Confirmation par Philippe VI, roi de France ("Phelippes, par la Grace de Dieu, roys de France"), d’un acte de Charles IV le Bel, roi de France ("le roy Charles"), octroyant 540 livres de rente à l’un de ses serviteurs et ses successeurs.<cei:lb/> Jonathan Dumont.</cei:abstract>
                            <cei:issued>
                                <cei:placeName>Paris ("Ce fu à Paris")</cei:placeName>
                                <cei:dateRange from="13390799" to="13390799">1339-07-99</cei:dateRange>
                            </cei:issued>
                            <cei:witnessOrig>
                                <cei:traditioForm>Original</cei:traditioForm>
                                <cei:figure/>
                                <cei:archIdentifier><cei:settlement>Paris</cei:settlement>, <cei:repository>Bibliothèque nationale</cei:repository>, <cei:idno>Latin 17058</cei:idno>, <cei:scope>pièce 54</cei:scope></cei:archIdentifier>
                                <cei:physicalDesc>
                                    <cei:decoDesc>
                                        <cei:p n="Ekphrasis">Ph sehr stark vergrössert, letztlich ein Hohlbuchstabe: in den Schäften und Bögen eine dicke Linie, dort mittig eine Scheibe.</cei:p><cei:p n="Stil und Einordnung">Eine <cei:index indexName="IllUrkGlossar" lemma="PhilippeVI">Urkunde des Philippe de Valois</cei:index>: Diese mit einfachen Mitteln gestaltete Urkunde, bei der die Königsabbreviatur letztlich nur durch ihre Grösse besticht - sie reicht weit in den oberen Rand hinein - möchte wegen des geringen Aufwandes häufiger verwendet worden sein. In den vierziger Jahren sind in dieser Sammlung weitere Beispiele vorhanden, so z. B. am <cei:ref target="https://www.monasterium.net/mom/IlluminierteUrkundenFrankreich/1346-04-27_Paris/charter">27. April 1346</cei:ref> oder im <cei:ref target="https://www.monasterium.net/mom/IlluminierteUrkundenFrankreich/1346-10-99_Paris/charter">Oktober 1346</cei:ref>.</cei:p><cei:p n="Autorensigle">Gabriele Bartz</cei:p>
                                    </cei:decoDesc>
                                    <cei:material>Pergament</cei:material>
                                    <cei:dimensions>57,0 + 8,7 x 51,5 cm</cei:dimensions>
                                    <cei:condition/>
                                </cei:physicalDesc>
                                <cei:auth>
                                    <cei:notariusDesc/>
                                    <cei:sealDesc>Absent, traces (lacs de soie verte et rouge, "avons fait mectre nostre scel")</cei:sealDesc>
