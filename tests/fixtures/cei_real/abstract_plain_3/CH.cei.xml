          <cei:idno id="Hochstift_Freising_Urkunden&#xA;____________2256">Hochstift Freising Urkunden
            2256</cei:idno>
          <cei:chDesc>
            <cei:abstract>Bischof Johann Franz von Freising bekundet, dass er nach seiner
              bestätigten Wahl zum Bischof und dem dadurch eingetretenen Haupt- und Nebenfall im
              Hochstift Freising dem Maximilian Herr von Pelkofen ("Pelckhoven") und Hohenbuchbach
              auf Moosach, kurbayerischem Revisionsrat und Truchseß in München, als Gewalthaber und
              Lehenträger der drei Töchter des Ladislaus Schrenk von Notzing zu Egmating namens
              Maria Sibilla Theresia, Maria Sidonia Rosalia und Maria Johanna Petronilla den
              Aislmayr Hof in Egmating zu Lehen verliehen hat; S: Bischof Johann Franz von
              Freising</cei:abstract>
            <cei:issued>
              <cei:date value="16970523">1697 Mai 23</cei:date>
              <cei:placeName>Freising</cei:placeName>
            </cei:issued>
